# ─── Server ───────────────────────────────────────────────
PORT=10000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────────
# For Neon PostgreSQL:
# DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/agrilink?sslmode=require
# For Supabase PostgreSQL (Important: Render requires the IPv4 connection pooler URL on port 6543):
# DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://agri_link_user:zF4Hn3lEisADM5Vvi4PJZbVajuPk970v@dpg-d9ke3upt0dsc739hg9ag-a.virginia-postgres.render.com/agri_link

# ─── JWT ──────────────────────────────────────────────────
JWT_SECRET=replace_with_64_char_random_hex_string_here_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=another_64_char_random_hex_string_here_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Cloudinary ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Firebase FCM ─────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/firebase-service-account.json

# ─── Commission ───────────────────────────────────────────
COMMISSION_RATE=0.01

# ─── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10

# ─── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://agrilink-backend.onrender.com

# ─── SMTP / Email ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM='"AgriLink Support" <your_smtp_user@gmail.com>'
