# ─── Application ───────────────────────────────────────────
APK_PATH=./app/app-release.apk
APP_PACKAGE=com.agrilink.app
APP_ACTIVITY=com.agrilink.app.MainActivity
APP_DEBUG_PACKAGE=com.agrilink.app.debug

# ─── Appium Server ─────────────────────────────────────────
APPIUM_HOST=localhost
APPIUM_PORT=4723
APPIUM_BASE_PATH=/

# ─── Test Credentials ──────────────────────────────────────
BUYER_EMAIL=testbuyer@agrilink.com
BUYER_PASSWORD=TestBuyer@123
SELLER_EMAIL=testseller@agrilink.com
SELLER_PASSWORD=TestSeller@123
ADMIN_EMAIL=admin@agrilink.com
ADMIN_PASSWORD=Admin@123456

INVALID_EMAIL=notanemail
INVALID_PASSWORD=wrongpass

# ─── Device ────────────────────────────────────────────────
DEVICE_NAME=emulator-5554
PLATFORM_VERSION=13.0
UDID=

# ─── Timeouts (ms) ─────────────────────────────────────────
IMPLICIT_TIMEOUT=8000
EXPLICIT_TIMEOUT=30000
INSTALL_TIMEOUT=120000
COMMAND_TIMEOUT=300000

# ─── Backend ───────────────────────────────────────────────
BACKEND_URL=https://agri-link-omib.onrender.com

# ─── Reporting ─────────────────────────────────────────────
REPORT_DIR=./reports
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_ON_PASS=false
EXCEL_REPORT=true
