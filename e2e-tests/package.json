{
  "name": "agrilink-e2e-automation",
  "version": "1.0.0",
  "description": "Enterprise-grade Appium 2.x E2E automation framework for AgriLink Flutter Android APK",
  "author": "AgriLink QA Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "mocha --config .mocharc.json",
    "test:auth": "mocha --config .mocharc.json --grep '@auth'",
    "test:products": "mocha --config .mocharc.json --grep '@products'",
    "test:orders": "mocha --config .mocharc.json --grep '@orders'",
    "test:seller": "mocha --config .mocharc.json --grep '@seller'",
    "test:smoke": "mocha --config .mocharc.json --grep '@smoke'",
    "test:regression": "mocha --config .mocharc.json --grep '@regression'",
    "test:forms": "mocha --config .mocharc.json --grep '@forms'",
    "report:open": "open reports/mochawesome/mochawesome.html || start reports/mochawesome/mochawesome.html",
    "appium:start": "appium --use-plugins execute-driver,images",
    "device:list": "adb devices",
    "apk:install": "node scripts/install-apk.js",
    "ai:discover": "node scripts/ai-discovery.js",
    "clean": "rimraf reports/screenshots reports/failures reports/mochawesome reports/logs",
    "prectest": "npm run clean || true"
  },
  "dependencies": {
    "webdriverio": "^8.38.0",
    "@wdio/appium-service": "^8.38.0"
  },
  "devDependencies": {
    "mocha": "^10.4.0",
    "chai": "^4.4.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "exceljs": "^4.4.0",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "dotenv": "^16.4.5",
    "rimraf": "^5.0.7",
    "moment": "^2.30.1",
    "axios": "^1.7.2",
    "allure-mocha": "^2.14.0"
  }
}
